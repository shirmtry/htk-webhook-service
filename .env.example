# Private Vercel Blob store token. Leave empty locally to use a file-backed PGlite DB.
BLOB_READ_WRITE_TOKEN=

# Optional: local file-backed PGlite directory (defaults to ./.data/pg)
PGLITE_DIR=

# Optional: bearer secret for the delivery worker cron endpoint (GET/POST /api/jobs/deliver)
CRON_SECRET=

# Optional: set to 1 to allow live deliveries to private/local targets during local testing.
ALLOW_PRIVATE_TARGETS=
